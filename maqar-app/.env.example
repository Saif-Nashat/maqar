# Copy this file to ".env.local" and fill in your Supabase project values.
# Both are safe to expose in a frontend build (the anon key is public by design;
# real protection comes from Row-Level Security policies in the database).
#
# Find them in your Supabase dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Leave both blank/absent to run the app in local demo mode (no backend needed).
